# Copy this file to .env for local settings. Git ignores .env, so tokens stay private.

# A GitHub token is optional. Without one, GitHub allows 60 requests per hour;
# with one, 5000. GIG_GITHUB_TOKEN, GITHUB_TOKEN, and GH_TOKEN all work, checked
# in that order. If none
# is set and the GitHub CLI is logged in, the tool uses `gh auth token`.
GITHUB_TOKEN=

# Optional settings use the GIG_ prefix. Defaults are shown; uncomment to change.
# Full list: docs/configuration.md
# GIG_TARGET_YEAR=2027
# GIG_CACHE_TTL_SECONDS=3600
# GIG_HTTP_TIMEOUT_SECONDS=30
# GIG_USE_GH_CLI=true
# GIG_DATA_DIR=
# GIG_CACHE_DIR=
