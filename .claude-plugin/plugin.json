{
  "name": "git-into-gsoc",
  "version": "0.24.0",
  "description": "Evidence-based preparation for Google Summer of Code: find organizations, repositories and free beginner issues, get oriented in a codebase, and prepare a proposal, with an Agent Skill and an MCP server.",
  "author": {
    "name": "git-into-gsoc contributors",
    "url": "https://github.com/anandkaranubc/git-into-gsoc"
  },
  "homepage": "https://github.com/anandkaranubc/git-into-gsoc",
  "repository": "https://github.com/anandkaranubc/git-into-gsoc",
  "documentationUrl": "https://github.com/anandkaranubc/git-into-gsoc/blob/main/docs/assistants.md",
  "supportUrl": "https://github.com/anandkaranubc/git-into-gsoc/issues",
  "privacyPolicyUrl": "https://github.com/anandkaranubc/git-into-gsoc/blob/main/docs/privacy.md",
  "icon": "./brand/logo/mark-tile-512.png",
  "license": "MIT",
  "keywords": [
    "gsoc",
    "google-summer-of-code",
    "open-source",
    "onboarding",
    "github",
    "mcp"
  ],
  "mcpServers": {
    "git-into-gsoc": {
      "command": "uvx",
      "args": [
        "--from",
        "${CLAUDE_PLUGIN_ROOT}",
        "git-into-gsoc",
        "mcp"
      ]
    }
  }
}
