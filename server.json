    "source": "github"
  },
  "websiteUrl": "https://anandkaranubc.github.io/git-into-gsoc/",
  "icons": [
    {
      "src": "https://anandkaranubc.github.io/git-into-gsoc/brand/logo/mark-tile-512.png",
