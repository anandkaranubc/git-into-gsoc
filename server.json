      "sizes": [
        "512x512"
      ]
    },
    {
      "src": "https://anandkaranubc.github.io/git-into-gsoc/brand/logo/mark-tile.svg",
      "mimeType": "image/svg+xml",
      "sizes": [
        "any"
      ]
    }
  ],
  "version": "0.24.0",
  "packages": [
    {
